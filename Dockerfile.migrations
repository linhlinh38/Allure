FROM node:latest

WORKDIR /app

# Copy package files and install dependencies
COPY package*.json ./
RUN npm ci

# Copy source files (including TypeScript files)
COPY ./src ./src
COPY tsconfig.json ./

# Install ts-node globally for running migrations
RUN npm install -g ts-node typescript

# Set environment variables
ENV NODE_ENV=production

# Create a script to run both migration commands
RUN echo '#!/bin/bash \n\
set -e \n\
echo "Generating migrations..." \n\
npm run migration:generate \n\
echo "Running migrations..." \n\
npm run migration:run \n\
' > /app/run-migrations.sh

# Make the script executable
RUN chmod +x /app/run-migrations.sh

# Run the script
CMD ["/app/run-migrations.sh"]